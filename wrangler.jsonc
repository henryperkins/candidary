{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candidary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/join/*", "/manage/*", "/create", "/event/*", "/host/unsubscribe/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "candidary-core",
      "database_id": "60bec5de-c8c7-41b5-a26b-2d3f7d184c71",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "candidary-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "workflows": [
    {
      "name": "candidary-export",
      "binding": "EXPORT_WORKFLOW",
      "class_name": "ExportWorkflow"
    }
  ],
  // Two independent schedules. Notification delivery runs hourly so a failed send
  // retries within the hour instead of waiting a day; retention cleanup keeps its
  // own daily slot and its own failure boundary.
  "triggers": {
    "crons": ["17 3 * * *", "47 * * * *"]
  },
  "vars": {
    "APP_ORIGIN": "https://candidary.online",
    "R2_ACCOUNT_ID": "a77e479f6736120eadd99973dbeb705e",
    "R2_BUCKET_NAME": "candidary-media",
    "EMAIL_FROM": "hello@candidary.online"
  },
  "observability": {
    "enabled": true
  }
}
