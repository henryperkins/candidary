{
  "name": "candidary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:app-icons": "node scripts/generate-app-icons.mjs",
    "verify:pwa-build": "node scripts/verify-pwa-build.mjs",
    "deploy": "npm run build && npm run verify:pwa-build && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "test:load:wedding": "node scripts/wedding-load-harness.mjs",
    "test:load:rsvp": "node scripts/rsvp-load-harness.mjs",
    "event-start-backfill:freeze": "node --experimental-strip-types scripts/event-start-backfill.ts freeze",
    "event-start-backfill:freeze:verify": "node --experimental-strip-types scripts/event-start-backfill.ts verify-freeze",
    "event-start-backfill:plan": "node --experimental-strip-types scripts/event-start-backfill.ts plan",
    "event-start-backfill:verify": "node --experimental-strip-types scripts/event-start-backfill.ts verify",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "aws4fetch": "1.0.20",
    "fflate": "0.8.3",
    "hono": "4.12.31",
    "lucide-react": "1.25.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.46.0",
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  }
}
