{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://candidary.online"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "content-type"
        ]
      },
      "exposeHeaders": [
        "etag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
